# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Use your hosting domain (e.g. my-cube-timer.web.app) as the auth domain so sign-in works in the iPhone home-screen app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: App Check (Firebase console → App Check → register the web app with reCAPTCHA Enterprise).
# The site key is public. Without it, App Check is off.
VITE_APPCHECK_SITE_KEY=
# Optional: a debug token registered in App Check → Manage debug tokens, used on the dev server.
# Leave empty and the dev server prints a new one in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=
