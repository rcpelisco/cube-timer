{
  "name": "cube-timer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:csp": "vite build && CSP_ENFORCE=1 vite preview",
    "check:algs": "node scripts/check-algs.ts",
    "test:rules": "npx firebase-tools@14.9.0 emulators:exec --only firestore --project demo-cube-timer \"node scripts/test-rules.ts\"",
    "deploy": "npm run check:algs && npm run lint && npm run build && npx firebase-tools@14.9.0 deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "cubing": "0.66.1",
    "firebase": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
